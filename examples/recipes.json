  {
    "name": "atomic-drag-lifecycle",
    "steps": [
      {
        "call": {
          "name": "capture_region",
          "arguments": {
            "display_id": "fixture",
            "x": 100,
            "y": 60,
            "width": 400,
            "height": 200,
